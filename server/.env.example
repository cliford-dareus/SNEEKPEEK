# Copy this file to .env and fill in real values.
# cp .env.example .env

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sneekpeek

# Secret used to sign JWTs and signed cookies (use a long random string, 32+ chars)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Frontend origin for CORS and Socket.io (no trailing slash)
CLIENT_URL=http://localhost:5173

# production | development — affects cookie secure/sameSite flags
NODE_ENV=development

# Optional — defaults to 4000
PORT=4000
